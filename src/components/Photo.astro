---
import { image } from '../lib/paths';
interface Props {name:string;alt:string;class?:string;eager?:boolean;}
const {name,alt,class:className,eager=false}=Astro.props;
---
<img class={className} src={image(name)} srcset={`${image(name,800)} 800w, ${image(name)} 1600w`} sizes="(max-width: 700px) 100vw, 80vw" alt={alt} width="1600" height="1067" loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async"/>
