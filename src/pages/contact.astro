---
import Layout from '../layouts/Layout.astro';import {services} from '../data/content';import {url} from '../lib/paths';
---
<Layout title="Start your project" description="Discuss your Bay Area construction project with Sigura Construction. Call (408) 492-1379 or prepare an estimate inquiry.">
<section class="contact-page section"><div class="contact-intro"><p class="eyebrow">A new beginning / Get in touch</p><h1>Let’s build<br/>something<br/><em>exceptional.</em></h1><p>A few details. A shared vision.<br/>The first step toward a space that’s yours.</p><div class="contact-info"><a href="tel:+14084921379">(408) 492-1379 ↗</a><a href="mailto:info@siguraconstruction.com">info@siguraconstruction.com ↗</a><address>1290 Reamwood Ave STE A<br/>Sunnyvale, CA 94089</address><span>California contractor license #865155</span></div></div>
<div class="contact-form-wrap"><p class="eyebrow">Tell us what you have in mind</p><p class="form-notice">This independent demo prepares an email draft. It does not send or store your inquiry. You’ll review and send it in your email app.</p><form id="estimate-form" novalidate>
<div class="form-grid"><div class="field"><label for="name">Your name <span>*</span></label><input id="name" name="name" autocomplete="name" required minlength="2" aria-describedby="name-error"/><span id="name-error" class="field-error"></span></div><div class="field"><label for="email">Email address <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error"/><span id="email-error" class="field-error"></span></div><div class="field"><label for="phone">Phone number <span>*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" required pattern="[+0-9\(\) .\-]{7,25}" aria-describedby="phone-error"/><span id="phone-error" class="field-error"></span></div><div class="field"><label for="location">Project city or ZIP <span>*</span></label><input id="location" name="location" autocomplete="address-level2" required aria-describedby="location-error"/><span id="location-error" class="field-error"></span></div><div class="field full"><label for="service">What are you considering? <span>*</span></label><select id="service" name="service" required aria-describedby="service-error"><option value="">Select a service</option>{services.map(s=><option>{s.name}</option>)}<option>Kitchen & bathroom remodeling</option><option>Not sure yet</option></select><span id="service-error" class="field-error"></span></div><div class="field full"><label for="description">Tell us about your project <span>*</span></label><textarea id="description" name="description" rows="4" required minlength="20" aria-describedby="description-error" placeholder="Your ideas, priorities, and what you’d like to change…"></textarea><span id="description-error" class="field-error"></span></div><div class="field"><label for="budget">Budget range <span>(optional)</span></label><select id="budget" name="budget"><option value="">Prefer to discuss</option><option>Under $100,000</option><option>$100,000–$250,000</option><option>$250,000–$500,000</option><option>$500,000–$1 million</option><option>$1 million+</option></select></div><div class="field"><label for="timeline">Ideal timeline <span>(optional)</span></label><select id="timeline" name="timeline"><option value="">Still exploring</option><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>More than a year</option></select></div></div>
<p class="form-privacy">Your details stay in this browser until you choose to open your email app. <a href={url('privacy/')}>Privacy details</a></p><button class="button dark" type="submit">Prepare my inquiry <span>↗</span></button><p id="form-status" role="status" aria-live="polite"></p><div id="email-review" hidden><h3>Your inquiry is ready to review.</h3><p>Nothing has been sent. Open the draft below and send it from your email app, or copy the text into an email to info@siguraconstruction.com.</p><pre id="email-text"></pre><a id="email-draft" class="button dark" href="mailto:info@siguraconstruction.com">Open email draft <span>↗</span></a><button id="copy-inquiry" type="button" class="copy-button">Copy inquiry</button></div>
</form></div></section>
</Layout>
