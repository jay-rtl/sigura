---
import Layout from '../layouts/Layout.astro';import Hero from '../components/Hero.astro';import CTA from '../components/CTA.astro';
const credentials=[['01','California contractor license','#865155','The license number is published by Sigura Construction. Check the current record directly with the Contractors State License Board.','https://www.cslb.ca.gov/OnlineServices/CheckLicenseII/LicenseDetail.aspx?LicNum=865155','Check CSLB record'],['02','Best of Houzz Service','2026','The company’s awards page lists the 2026 Best of Houzz Service award. Explore the independent company profile.','https://www.houzz.com/professionals/general-contractors/sigura-construction-pfvwus-pf~503505748','Visit Houzz profile'],['03','Diamond Certified','Quality, recognized','Sigura publishes its Diamond Certified recognition. The independent report provides information about the certification and company.','https://www.diamondcertified.org/report/sigura-construction-inc/','View certification report'],['04','Better Business Bureau','Independent profile','The company identifies BBB accreditation on its website. Consult the current BBB profile for rating and accreditation details.','https://www.bbb.org/us/ca/san-jose/profile/general-contractor/sigura-construction-inc-1216-232093','Visit BBB profile']];
---
<Layout title="Recognition & credentials" description="Explore Sigura Construction’s published recognition, license #865155, and links to CSLB, Houzz, Diamond Certified, and BBB.">
<Hero eyebrow="Recognition / A foundation of trust" title={'Craft that earns\nrecognition.'} description="A considered look at published credentials, with direct links to independent records. Check the current details with each issuing organization."/>
<section class="section awards-list">{credentials.map(([n,label,title,copy,href,link])=><article><span>{n}</span><div><p class="eyebrow">{label}</p><h2>{title}</h2></div><div><p>{copy}</p><a class="text-link" href={href} target="_blank" rel="noopener noreferrer">{link} <span>↗</span></a></div></article>)}<p class="source-note">Recognition referenced from the company’s published information on October 13, 2026. External links open third-party verification pages. No live verification or rating feed is implied.</p></section><CTA/>
</Layout>
