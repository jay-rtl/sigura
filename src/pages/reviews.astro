---
import Layout from '../layouts/Layout.astro';import Hero from '../components/Hero.astro';import CTA from '../components/CTA.astro';
const reviews=[['Tao J.','Addition & bathroom remodel','Described design-to-construction guidance, courteous site staff, and hands-on attention to the finished work.'],['Len R.','Kitchen remodeling','Described a kitchen renovation that opened the room to the living area and brought in light through skylights.'],['Leah K.','Landscape & interior remodeling','Highlighted a renewed backyard, bathroom, and flooring, along with helpful suggestions on everyday details.']];
---
<Layout title="Homeowner experiences" description="Read a short customer review excerpt and attributed summaries of experiences published by Sigura Construction.">
<Hero eyebrow="Homeowner experiences / Trust in the details" title={'Spaces to love.\nStories to share.'} description="A home is personal. So is the experience of creating it. These accounts offer a glimpse of what homeowners have shared."/>
<section class="testimonial section"><span class="quote-mark">“</span><blockquote>The craftsmanship displayed by Sigura Construction, Inc. is remarkable.</blockquote><p class="quote-credit">LENNART F. · PUBLISHED CUSTOMER REVIEW EXCERPT</p></section>
<section class="section review-stories"><p class="eyebrow">In their own experience / Editorial summaries</p>{reviews.map(([name,type,body],i)=><article><span class="detail-number">0{i+1}</span><div><p class="eyebrow">{type}</p><p class="large-copy">{body}</p><h3>{name}</h3><small>Summary of a review published on the company website; not a direct quotation.</small></div></article>)}<p class="source-note">These selected accounts do not represent a calculated rating or all customer feedback. Review content was checked on October 13, 2026.</p><a class="text-link" href="https://www.houzz.com/professionals/general-contractors/sigura-construction-pfvwus-pf~503505748" target="_blank" rel="noopener noreferrer">Read the independent Houzz profile <span>↗</span></a></section><CTA/>
</Layout>
