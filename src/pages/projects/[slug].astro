---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Photo from '../../components/Photo.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import CTA from '../../components/CTA.astro';
import {projects} from '../../data/content';
import {url} from '../../lib/paths';
export function getStaticPaths(){return projects.map(p=>({params:{slug:p.slug},props:{project:p}}));}
const {project:p}=Astro.props;
---
<Layout title={`${p.name} — ${p.location}`} description={p.description} hero={p.image}>
<Hero eyebrow={`${p.location} / ${p.category}`} title={p.name} image={p.image}/>
<section class="section project-overview"><div><p class="eyebrow">The project</p><h2>{p.focus}</h2></div><div><p class="large-copy">{p.description}</p><p>{p.note}</p><dl><div><dt>Location</dt><dd>{p.location}</dd></div><div><dt>Project type</dt><dd>{p.category}</dd></div><div><dt>Builder</dt><dd>Sigura Construction, Inc.</dd></div></dl><a class="text-link" href={url(`services/${p.service}/`)}>Explore the service <span>↗</span></a></div></section>
<section class="project-gallery section" aria-label={`${p.name} photograph gallery`}>{p.gallery.map((name,i)=><figure data-reveal="mask"><Photo name={name} alt={`${p.name}, ${p.location} — portfolio photograph ${i+1}`}/><figcaption>FIG. {String(i+1).padStart(2,'0')} / {p.name.toUpperCase()} · {p.location.toUpperCase()}</figcaption></figure>)}</section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">The collection continues</p><h2>Another perspective.</h2></div><a class="text-link" href={url('projects/')}>All projects <span>↗</span></a></div><ProjectGrid limit={2} exclude={p.slug}/></section><CTA/>
</Layout>
