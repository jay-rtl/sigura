---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Comparison from '../components/Comparison.astro';
import Model from '../components/Model.astro';
import CTA from '../components/CTA.astro';
import {services, steps} from '../data/content';
import {url,image} from '../lib/paths';
---
<Layout title="Exceptional spaces. Built for living." description="Bay Area design-build craftsmanship since 2003. Explore Sigura Construction’s custom homes, remodeling, additions, ADUs, and outdoor living." hero="architecture" home>
  <section class="home-hero">
    <Photo name="architecture" alt="Contemporary home opening to a garden at dusk — architectural inspiration, not a Sigura project" eager class="hero-photo"/>
    <div class="hero-shade"></div><div class="hero-lines" aria-hidden="true"></div>
    <div class="hero-content"><p class="eyebrow"><span class="tiny-line"></span> BAY AREA DESIGN & BUILD · EST. 2003</p><h1 data-title><span class="title-line">Exceptional spaces.</span><span class="title-line">Built for <em>living.</em></span></h1><div class="hero-lower"><p>Thoughtful design. Exceptional craftsmanship.<br/>A home that feels unmistakably yours.</p><div class="hero-actions"><a class="button light" href={url('projects/')}>Explore our projects <span>↗</span></a><a class="text-link" href={url('contact/')}>Start your project <span>↗</span></a></div></div></div>
    <div class="hero-bottom"><a href="#introduction">SCROLL TO EXPLORE <span>↓</span></a><span>ARCHITECTURAL INSPIRATION · CONCEPT PHOTOGRAPHY</span><span>01 — 03</span></div>
    <span class="hero-side">CONSIDERED DESIGN. ENDURING CRAFT.</span>
  </section>
  <div class="credential-strip"><span>CALIFORNIA LICENSE <strong>#865155</strong></span><span>BUILDING IN THE BAY AREA <strong>SINCE 2003</strong></span><a href={url('awards/')}>CRAFTSMANSHIP, RECOGNIZED <span>↗</span></a></div>
  <section class="introduction section" id="introduction"><div class="intro-heading"><p class="eyebrow">01 / Built around you</p><h2>A house is built.<br/>A home is<br/><em>considered.</em></h2></div><div class="intro-body"><p class="large-copy" data-reveal="words">The way light falls. The spaces that bring you together. The details that make every day a little better.</p><p>At Sigura Construction, we bring your vision into focus through design and craftsmanship. From a thoughtfully remodeled kitchen to a custom home, it all begins with understanding how you want to live.</p><a class="text-link" href={url('about/')}>Get to know Sigura <span>↗</span></a><div class="history-stat"><span>2003</span><p>Our story began in the Bay Area.<br/>We’re still building it, one home at a time.</p></div></div></section>
  <section class="featured section"><div class="section-heading"><div><p class="eyebrow">02 / Selected work</p><h2>Spaces with<br/><em>a story to tell.</em></h2></div><div><p>A closer look at the details.<br/>A bigger picture of what’s possible.</p><a class="text-link" href={url('projects/')}>View the project collection <span>↗</span></a></div></div><ProjectGrid limit={2}/><div class="featured-foot"><span>REAL HOMES. INDIVIDUAL VISIONS.</span><span>THE PENINSULA & SOUTH BAY</span></div></section>
  <section class="expertise section"><div class="section-heading"><div><p class="eyebrow">A considered approach, at every scale</p><h2>Your possibilities.<br/><em>Our expertise.</em></h2></div><a class="text-link" href={url('services/')}>Explore all services <span>↗</span></a></div><div class="service-showcase"><div class="service-preview"><Photo name="addition" alt="Open living room in the Englewood addition and remodel"/><span>A NEW PERSPECTIVE ON HOME</span></div><div class="service-rows">{services.slice(0,6).map((s,i)=><a href={url(`services/${s.slug}/`)} data-service-image={image(s.image)}><span class="service-index">0{i+1}</span><span><h3>{s.name}</h3><small>{s.short}</small></span><span class="service-arrow">↗</span></a>)}</div></div></section>
  <Model/>
  <section class="transformation section"><div class="section-heading"><div><p class="eyebrow">04 / The art of transformation</p><h2>Same address.<br/><em>A whole new feeling.</em></h2></div><div><p>See what a different perspective can do.<br/>An actual Sigura remodeling transformation.</p><a class="text-link" href={url('before-after/')}>Explore before & after <span>↗</span></a></div></div><Comparison/></section>
  <section class="process-preview section"><div><p class="eyebrow">05 / A clear path forward</p><h2>From the first hello<br/>to <em>welcome home.</em></h2><a class="text-link" href={url('process/')}>Discover our approach <span>↗</span></a></div><div class="process-list">{steps.map(([name,headline],i)=><a href={url(`process/#step-${i+1}`)}><span>0{i+1}</span><div><h3>{name}</h3><p>{headline}</p></div><span>↗</span></a>)}</div></section>
  <section class="testimonial section"><p class="eyebrow">In our clients’ words</p><span class="quote-mark">“</span><blockquote>The craftsmanship displayed by Sigura Construction, Inc. is remarkable.</blockquote><p class="quote-credit">LENNART F. <span>·</span> CUSTOMER REVIEW EXCERPT</p><a class="text-link" href={url('reviews/')}>More homeowner experiences <span>↗</span></a></section>
  <CTA/>
</Layout>
