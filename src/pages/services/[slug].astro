---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Photo from '../../components/Photo.astro';
import Model from '../../components/Model.astro';
import {services,projects} from '../../data/content';
import {url} from '../../lib/paths';
export function getStaticPaths(){return services.map(s=>({params:{slug:s.slug},props:{service:s}}));}
const {service:s}=Astro.props;
const project=projects.find(p=>p.slug===s.project);
const related=services.find(r=>r.slug===s.related)!;
---
<Layout title={s.name} description={s.intro} hero={s.image}>
<Hero eyebrow={`Our expertise / ${s.name}`} title={s.headline} image={s.image} concept={s.concept}/>
<section class="section service-overview"><p class="eyebrow">The possibilities</p><div><h2>{s.short}</h2><p class="large-copy">{s.intro}</p><a class="button dark" href={url('contact/')}>Let’s discuss your project <span>↗</span></a></div></section>
<section class="section detail-columns">{s.details.map((title,i)=><div><span class="detail-number">0{i+1}</span><h3>{title}</h3><p>{s.body[i]}</p></div>)}</section>
{s.slug==='3d-design'&&<Model/>}
{project?<section class="section related-feature"><div><p class="eyebrow">In practice / Selected work</p><h2>{project.focus}</h2><p>{project.description}</p><p class="muted">{project.location} · {project.category}</p><a class="text-link" href={url(`projects/${project.slug}/`)}>Explore {project.name} <span>↗</span></a></div><a href={url(`projects/${project.slug}/`)}><Photo name={project.image} alt={project.description}/></a></section>:<section class="section planning-note"><p class="eyebrow">Before we begin</p><h2>Bring the questions.<br/><em>We’ll explore the possibilities.</em></h2><p>A project address, a few photographs, and a sense of what you want to achieve are a useful starting point. Tell us what matters most so the first conversation can focus on your needs.</p><a class="text-link" href={url('process/')}>Understand the process <span>↗</span></a></section>}
<section class="section faq-section"><div><p class="eyebrow">A little more clarity</p><h2>Good questions.<br/><em>A useful start.</em></h2></div><div>{s.faq.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
<section class="section related-link"><span class="eyebrow">You might also be considering</span><a href={url(`services/${related.slug}/`)}>{related.name}<span>↗</span></a></section><CTA/>
</Layout>
